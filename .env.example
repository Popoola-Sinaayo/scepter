# Resend API key (https://resend.com/api-keys) — used for contact form emails
RESEND_API_KEY=

# Inbox that receives website enquiries
CONTACT_TO_EMAIL=info@thescepterglobal.org

# Sender address. Must be on a domain verified in Resend.
# Until the domain is verified, use: The Scepter <onboarding@resend.dev>
# (Resend then only delivers to your own Resend account email.)
CONTACT_FROM_EMAIL=The Scepter <hello@thescepterglobal.com>

# Brevo (https://app.brevo.com) — footer newsletter subscribers
# Create an API key under Settings → SMTP & API → API keys
BREVO_API_KEY=
# Numeric list ID from Contacts → Lists (open the list; ID is in the URL / list details)
BREVO_LIST_ID=

# CLAY Conference registrations → Google Sheets (see README → "CLAY Conference registrations")
# Web app URL from the Apps Script deployment (ends in /exec)
GOOGLE_SHEETS_WEBHOOK_URL=
# Must match SECRET in google-apps-script/clay-registrations.gs
GOOGLE_SHEETS_WEBHOOK_SECRET=
