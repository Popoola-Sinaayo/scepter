# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that receives website enquiries
CONTACT_TO_EMAIL=info@thescepterglobal.com

# Sender address. Must be on a domain verified in Resend.
# Until the domain is verified, use: The Scepter <onboarding@resend.dev>
# (Resend then only delivers to your own Resend account email.)
CONTACT_FROM_EMAIL=The Scepter <hello@thescepterglobal.com>

# Optional: Resend segment ID that footer subscribers are added to
RESEND_SEGMENT_ID=
